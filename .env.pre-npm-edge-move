# ── Nginx Proxy Manager provisioning (scripts/npm-proxy-hosts.py) ────────────
# NPM runs OUTSIDE this compose stack (usually port 81). Provide the admin
# login or a persistent API token; setup.sh then creates the 6 proxy hosts
# (app/api/auth/rankings/community/admin) and a wildcard cert.
NPM_API_URL=http://192.168.1.71:81
NPM_ADMIN_EMAIL=admin@innotel.us
NPM_ADMIN_PASSWORD=DD@l1lama
NPM_API_TOKEN=
NPM_BASE_DOMAIN=rizzaura.net
# Docker host IP that NPM forwards to (the host running this stack)
NPM_UPSTREAM_HOST=192.168.1.46
NPM_LETSENCRYPT_EMAIL=admin@rizzaura.net
# Wildcard SSL: ONE cert for *.<BASE_DOMAIN> via DNS-01.
# For a TSIG/RFC2136 dynamic-DNS setup, save the rfc2136 provider (TSIG key
# name/secret/algorithm + server) as a credential in NPM → Credentials, then
# put its credential id here:
NPM_WILDCARD_CERT=0
NPM_DNS_PROVIDER=rfc2136
NPM_DNS_PROVIDER_CREDENTIALS=

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=8000

# Point to Zeus's single OmniRoute instance
OMNIROUTE_BASE_URL=http://192.168.1.46:20128/v1
