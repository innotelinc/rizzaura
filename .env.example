# ── Rizz Aura — Cash Shop (Stripe) ─────────────────────────────────────────
# Copy this file to `.env` and fill in the values. The server also reads real
# environment variables (e.g. `export STRIPE_SECRET_KEY=...` or docker -e), so
# .env is optional but handy for local dev. No publishable key needed — the
# hosted Checkout page is created server-side.

# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... in dev)
STRIPE_SECRET_KEY=sk_test_xxx

# Signing secret from https://dashboard.stripe.com/webhooks
# (create an endpoint → https://<your-host>/api/webhook → event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the site — Stripe redirects buyers here after checkout.
# Use your real domain in production, http://localhost:4173 in local dev.
APP_URL=http://localhost:4173

# Server port (default 4173)
PORT=4173
