# ── Rizz Aura — Global Leaderboard Platform ──────────────────────────────────
# Copy this file to `.env` and fill in the values. setup.sh generates fresh
# secrets for you on first run. The server also reads real environment
# variables, so .env is optional but handy for local dev / compose.

# ── Domain ───────────────────────────────────────────────────────────────────
# Everything derives from this one value: subdomains (app/rankings/community/
# admin/api/auth), the Authentik public URL, and the frontend cross-links.
# Change it once rizzaura.net DNS is live and re-run setup.sh / rebuild.
BASE_DOMAIN=rizzaura.net
# Public URLs — derived from BASE_DOMAIN by docker compose when unset; set
# them explicitly only to override.
# APP_URL=https://app.rizzaura.net
# API_URL=https://api.rizzaura.net
# APP_ORIGINS=https://app.rizzaura.net,https://rankings.rizzaura.net,https://community.rizzaura.net,https://admin.rizzaura.net
# Signing secret for session cookies (setup.sh generates a fresh one)
SESSION_SECRET=change-me

# ── Authentik (SSO) ──────────────────────────────────────────────────────────
# Instances usually run at https://auth.<BASE_DOMAIN> (provisioned by
# scripts/provision-authentik.py, which writes the client id/secret below).
AUTHENTIK_ISSUER=https://auth.rizzaura.net
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ADMIN_GROUP=rizz-aura-admins
# Internal (kept in .env by setup.sh)
AUTHENTIK_VERSION=2025.6.3
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_TOKEN=change-me
AUTHENTIK_POSTGRES_PASSWORD=change-me
AUTHENTIK_REDIS_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@rizzaura.net
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me

# ── Cash Shop (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI achievement recommendations (OpenAI-compatible) ───────────────────────
# Defaults to the platform's single OmniRoute gateway (Group 2, `2-voice`), on
# the gateway host 192.168.1.46 — this stack runs no gateway of its own. Dial the
# SSO proxy in front of it, :20129: the gateway's own port answers on that host's
# loopback and bridge alone (Cerulean SSO is its only gate), and a compose service
# name is not an address — this project is not on that service's network. Any
# OpenAI-compatible /chat/completions endpoint works (OpenAI, Groq, Together,
# Ollama, ...).
AI_BASE_URL=http://192.168.1.46:20129/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── OmniRoute (LLM API proxy, profile "ai") ──────────────────────────────────
# Secrets — setup.sh mints the API key and wires it into AI_API_KEY.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest
OMNIROUTE_JWT_SECRET=change-me
OMNIROUTE_API_KEY_SECRET=change-me
OMNIROUTE_INITIAL_PASSWORD=change-me
OMNIROUTE_WS_BRIDGE_SECRET=change-me

# ── Nginx Proxy Manager provisioning (scripts/npm-proxy-hosts.py) ────────────
# NPM runs OUTSIDE this compose stack (usually port 81). Provide the admin
# login or a persistent API token; setup.sh then creates the 6 proxy hosts
# (app/api/auth/rankings/community/admin) and a wildcard cert.
NPM_API_URL=http://127.0.0.1:81
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
NPM_API_TOKEN=
NPM_BASE_DOMAIN=rizzaura.net
# Docker host IP that NPM forwards to (the host running this stack)
NPM_UPSTREAM_HOST=
NPM_LETSENCRYPT_EMAIL=admin@rizzaura.net
# Wildcard SSL: ONE cert for *.<BASE_DOMAIN> via DNS-01.
# For a TSIG/RFC2136 dynamic-DNS setup, save the rfc2136 provider (TSIG key
# name/secret/algorithm + server) as a credential in NPM → Credentials, then
# put its credential id here:
NPM_WILDCARD_CERT=1
NPM_DNS_PROVIDER=rfc2136
NPM_DNS_PROVIDER_CREDENTIALS=

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=8000

# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# The platform's only secret store: HashiCorp Vault (KV v2), hosted by
# Cerulean. Values live there, and .env may name one with a reference:
#
#   AUTHENTIK_CLIENT_SECRET=vault://cerulean/rizzaura#AUTHENTIK_CLIENT_SECRET
#
# Resolution is the operator's step, not this stack's: nothing here resolves a
# `vault://` value at runtime, so Compose would pass the literal string to the
# container. Write the resolved value into the gitignored .env (see
# docs/stack.md) and treat a reference left in place as a deployment error.
#
# Cerulean's Vault bootstrap mints this stack's path-scoped token
# (VAULT_PRODUCT_TOKENS=rizzaura there) and writes it to
# ./data/vault/token/rizzaura.token; copy that file in, then move any plaintext
# values across with scripts/vault-migrate.py:
#
#   VAULT_ADDR=http://<cerulean-host>:8200 \
#     VAULT_TOKEN_FILE=./data/vault/token/rizzaura.token \
#     VAULT_PREFIX=cerulean VAULT_PATH=rizzaura \
#     python3 scripts/vault-migrate.py --from-env-file .env \
#       --keys AUTHENTIK_CLIENT_SECRET,POSTGRES_PASSWORD
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/rizzaura.token
VAULT_PREFIX=cerulean
VAULT_PATH=rizzaura
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by Rizz Aura sign-in.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
