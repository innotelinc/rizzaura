{
  "name": "rizzaura-platform",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/app",
    "dev:app": "npm run dev -w apps/app",
    "dev:rankings": "npm run dev -w apps/rankings",
    "dev:community": "npm run dev -w apps/community",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "build:app": "npm run build -w apps/app",
    "build:rankings": "npm run build -w apps/rankings",
    "build:community": "npm run build -w apps/community",
    "build:admin": "npm run build -w apps/admin",
    "serve": "node api/server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
